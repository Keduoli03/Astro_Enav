---
import { searchGroups, defaultSearch } from '../data/searchConfig';
import { Icon } from 'astro-icon/components';

const defaultGroupId = searchGroups.find((group) =>
  group.engines.some((engine) => engine.id === defaultSearch.id)
)?.id || searchGroups[0]?.id || '';
---

<div id="search" class="s-search mx-auto!" data-search-root="main">
  <div id="search-list-menu" class="hide-type-list">
    <div class="s-type text-center">
      <div class="s-type-list big" role="group" aria-label="搜索分类">
        {searchGroups.map((group) => (
          <button
            type="button"
            class="search-group-tab"
            data-search-group={group.id}
            aria-pressed={group.id === defaultGroupId ? 'true' : 'false'}
          >
            <span>{group.label}</span>
          </button>
        ))}
      </div>
    </div>
  </div>

  <form action={defaultSearch.url} method="get" target="_blank" class="super-search-fm">
    <label class="sr-only" for="search-text">搜索关键词</label>
    <input
      type="search"
      id="search-text"
      class="smart-tips search-key w-full"
      name="q"
      placeholder={defaultSearch.placeholder}
      autocomplete="off"
      aria-autocomplete="list"
      aria-controls="search-suggestions"
    />
    <button class="submit" type="submit" aria-label="搜索">
      <Icon name="ri:search-line" aria-hidden="true" />
    </button>
  </form>

  <div id="search-list" class="hide-type-list">
    {searchGroups.map((group) => (
      <div
        class={`search-group ${group.id} ${group.id === defaultGroupId ? 's-current' : ''}`}
        data-search-panel={group.id}
        hidden={group.id !== defaultGroupId}
      >
        <ul class="search-type" aria-label={`${group.label}搜索引擎`}>
          {group.engines.map((engine) => (
            <li>
              <input
                class="sr-only"
                type="radio"
                name="type"
                id={engine.id}
                value={engine.url}
                data-placeholder={engine.placeholder}
                checked={engine.id === defaultSearch.id}
              />
              <label for={engine.id}><span class="text-muted">{engine.label}</span></label>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div id="smart-card" class="card search-smart-tips search-hot-text rounded-xl" hidden>
    <ul id="search-suggestions" data-search-suggestions hidden></ul>
  </div>
</div>
