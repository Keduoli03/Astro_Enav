<style is:global>
  /* ============================================================
   * Tokens (light)
   * ============================================================ */
  :root {
    --tool-brand: #1677ff;
    --tool-brand-hover: #1668e0;
    --tool-brand-soft: rgba(22, 119, 255, 0.08);
    --tool-text: #1f2937;
    --tool-text-soft: #5c6773;
    --tool-text-mute: #7c8794;
    --tool-border: rgba(15, 23, 42, 0.08);
    --tool-border-strong: rgba(15, 23, 42, 0.14);
    --tool-surface: #ffffff;
    --tool-surface-soft: rgba(247, 250, 254, 0.9);
    --tool-radius-lg: 10px;
    --tool-radius-md: 8px;
    --tool-radius-sm: 6px;
    --tool-shadow: none;
  }
  .io-black-mode {
    --tool-brand: #2d8cff;
    --tool-brand-hover: #4c9dff;
    --tool-brand-soft: rgba(45, 140, 255, 0.14);
    --tool-text: #e6ebf1;
    --tool-text-soft: #a9b1ba;
    --tool-text-mute: #7b8591;
    --tool-border: rgba(255, 255, 255, 0.06);
    --tool-border-strong: rgba(255, 255, 255, 0.12);
    --tool-surface: #2c2e2f;
    --tool-surface-soft: rgba(30, 32, 34, 0.7);
    --tool-shadow: none;
  }

  /* ============================================================
   * Bootstrap conflict reset
   * Bootstrap reboot sets `label { display:inline-block; margin-bottom:.5rem }`
   * as UNLAYERED CSS, which out-cascades Tailwind's layered `flex/block/grid`
   * utilities — collapsing full-width labels (upload dropzones, editor fields)
   * to their content width. Neutralize it; button-like labels opt back in with
   * `inline-flex!`.
   * ============================================================ */
  .tool-content label {
    display: block;
    margin-bottom: 0;
  }

  /* ============================================================
   * Tabs
   * ============================================================ */
  .tool-switch {
    display: inline-flex;
    padding: 4px;
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.05);
    gap: 4px;
    box-shadow: inset 0 0 0 1px rgba(15, 23, 42, 0.03);
  }
  .tool-tab {
    border: 0;
    background: transparent;
    color: var(--tool-text-soft);
    padding: 8px 18px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.18s ease;
  }
  .tool-tab.active {
    background: var(--tool-brand);
    color: #fff;
    box-shadow: 0 6px 16px rgba(22, 119, 255, 0.22);
  }
  .tool-tab:hover { color: var(--tool-text); background: rgba(255, 255, 255, 0.6); }
  .tool-tab.active:hover { color: #fff; background: var(--tool-brand); }

  /* ============================================================
   * Field
   * ============================================================ */
  .tool-field { margin-bottom: 1.25rem; }
  .tool-field:last-child { margin-bottom: 0; }
  .tool-field__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }
  .tool-field__label {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    color: var(--tool-text);
    font-weight: 600;
    font-size: 0.92rem;
    letter-spacing: 0.01em;
  }
  .tool-field__hint {
    color: var(--tool-text-mute);
    font-weight: 400;
    font-size: 0.8rem;
  }
  .tool-field__suffix { display: inline-flex; gap: 6px; flex-wrap: wrap; }
  .tool-field__desc {
    margin: 6px 0 0;
    color: var(--tool-text-mute);
    font-size: 0.78rem;
  }
  .tool-label { /* legacy alias, still used in some places */
    color: var(--tool-text);
    font-weight: 600;
  }

  /* ============================================================
   * Preview box
   * ============================================================ */
  .tool-preview-box {
    min-height: 260px;
    border-radius: 10px;
    background:
      linear-gradient(var(--tool-surface-soft), var(--tool-surface-soft)),
      repeating-conic-gradient(rgba(15, 23, 42, 0.03) 0% 25%, transparent 0% 50%);
    background-size: auto, 20px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 14px;
    border: 1px solid var(--tool-border);
  }
  .tool-preview-image {
    max-width: 100%;
    max-height: 280px;
    display: block;
    border-radius: 8px;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
  }
  .tool-preview-empty {
    color: var(--tool-text-mute);
    text-align: center;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 220px;
  }

  /* ============================================================
   * Toolbar (buttons themselves are Tailwind utilities)
   * ============================================================ */
  .tool-toolbar,
  .tool-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  /* ============================================================
   * Status
   * ============================================================ */
  .tool-status {
    min-height: 22px;
    font-size: 0.85rem;
    color: var(--tool-text-mute);
  }
  .tool-status--error { color: #ef4444 !important; }

  /* ============================================================
   * Disabled link/button state (toggled from vanilla JS)
   * ============================================================ */
  .tool-disabled {
    pointer-events: none;
    opacity: 0.45;
  }

  /* ============================================================
   * Collapse (<details>)
   * ============================================================ */
  .tool-collapse {
    border: 1px solid var(--tool-border);
    border-radius: var(--tool-radius-md);
    background: var(--tool-surface-soft);
    margin-bottom: 1.25rem;
    overflow: hidden;
  }
  .tool-collapse__summary {
    list-style: none;
    cursor: pointer;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    color: var(--tool-text);
    user-select: none;
  }
  .tool-collapse__summary::-webkit-details-marker { display: none; }
  .tool-collapse__title { font-size: 0.92rem; }
  .tool-collapse__hint {
    color: var(--tool-text-mute);
    font-weight: 400;
    font-size: 0.78rem;
    margin-left: auto;
  }
  .tool-collapse__chevron {
    color: var(--tool-text-mute);
    font-size: 1.4rem;
    line-height: 1;
    transform: rotate(90deg);
    transition: transform 0.18s ease;
  }
  .tool-collapse[open] .tool-collapse__chevron { transform: rotate(-90deg); }
  .tool-collapse__body {
    padding: 4px 16px 16px;
    border-top: 1px dashed var(--tool-border);
    background: var(--tool-surface);
  }

  /* ============================================================
   * Progress bar
   * ============================================================ */
  .tool-progress {
    height: 8px;
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.06);
    overflow: hidden;
  }
  .tool-progress__bar {
    height: 100%;
    background: linear-gradient(90deg, var(--tool-brand), #4c9dff);
    border-radius: 999px;
    transition: width 0.3s ease;
  }

  /* ============================================================
   * Audio row (used in tts)
   * ============================================================ */
  .tool-audio-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: var(--tool-radius-md);
    background: var(--tool-surface-soft);
    border: 1px solid var(--tool-border);
  }
  .tool-audio-row__seq {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    padding: 2px 8px;
    background: var(--tool-brand-soft);
    color: var(--tool-brand);
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }
  .tool-audio-row audio {
    flex: 1 1 240px;
    min-width: 200px;
    height: 34px;
  }

  /* ============================================================
   * Responsive
   * ============================================================ */
  @media (max-width: 767.98px) {
    .tool-switch { width: 100%; }
    .tool-tab { flex: 1 1 0; text-align: center; }
    .tool-field__head { flex-direction: column; align-items: flex-start; }
    .tool-audio-row audio { flex-basis: 100%; }
  }

  /* ============================================================
   * Dark mode overrides
   * ============================================================ */
  .io-black-mode .tool-switch {
    background: rgba(255, 255, 255, 0.06);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
  }
  .io-black-mode .tool-tab { color: var(--tool-text-soft); }
  .io-black-mode .tool-tab:hover { color: var(--tool-text); background: rgba(255, 255, 255, 0.05); }
  .io-black-mode .tool-tab.active,
  .io-black-mode .tool-tab.active:hover {
    background: var(--tool-brand);
    color: #fff;
  }
  .io-black-mode .tool-preview-box {
    background:
      linear-gradient(var(--tool-surface-soft), var(--tool-surface-soft)),
      repeating-conic-gradient(rgba(255, 255, 255, 0.03) 0% 25%, transparent 0% 50%);
    background-size: auto, 20px 20px;
  }
  .io-black-mode .tool-collapse {
    background: rgba(255, 255, 255, 0.02);
  }
  .io-black-mode .tool-collapse__body {
    background: rgba(20, 22, 24, 0.4);
  }
  .io-black-mode .tool-progress { background: rgba(255, 255, 255, 0.08); }
</style>
