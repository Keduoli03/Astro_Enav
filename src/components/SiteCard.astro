---
// src/components/SiteCard.astro
import { Icon } from 'astro-icon/components'

interface SiteCardProps {
  url?: string;
  title?: string;
  description?: string;
  id?: string;
  logo?: string;
  icon?: string;
  iconColor?: string;
  iconBg?: string;
  showDirectLink?: boolean;
}

// 提供完整的默认值
const defaultData: Required<SiteCardProps> = {
  url: "#",
  title: "未命名网站",
  description: "暂无描述",
  id: "",
  logo: "/images/logos/default.webp",
  icon: "",
  iconColor: "",
  iconBg: "",
  showDirectLink: true
};

// 安全解构（确保所有字段都有值）
const {
  url,
  title,
  description,
  id,
  logo,
  icon,
  iconColor,
  iconBg,
  showDirectLink
} = {
  ...defaultData,
  ...Astro.props.data
};

// 从URL中提取域名用于favicon
const getDomain = (url: string) => {
  try {
    const domain = new URL(url.startsWith('http') ? url : `https://${url}`).hostname;
    return domain.replace('www.', '');
  } catch {
    return null;
  }
};

const domain = getDomain(url);
const isDefaultLogo = logo === defaultData.logo;
const isLogoEmpty = !logo || logo.trim() === '';
const isInternalUrl = url.startsWith('/');
const hasCustomIcon = Boolean(icon && icon.trim());

let faviconUrl = logo;

if (hasCustomIcon) {
  faviconUrl = '';
} else if (isLogoEmpty) {
  faviconUrl = domain ? `https://favicon.im/${encodeURIComponent(domain)}?larger=true` : defaultData.logo;
} else if (!isDefaultLogo) {
  if (!logo.startsWith('http') && !logo.startsWith('//')) {
    faviconUrl = logo.startsWith('/')
      ? logo
      : (domain ? `https://favicon.im/${encodeURIComponent(domain)}?larger=true` : defaultData.logo);
  }
} else {
  faviconUrl = domain ? `https://favicon.im/${encodeURIComponent(domain)}?larger=true` : logo;
}
---

<div class="url-card px-[15px] w-1/2 md:w-1/3 xl:w-1/5 2xl:w-1/6">
  <div class="url-body default">
    <!-- 主卡片链接 -->
    <a 
      href={url} 
      target={isInternalUrl ? undefined : '_blank'} 
      data-id={id}
      data-url={url}
      class="card no-c mb-6!"
      data-toggle="tooltip"
      data-placement="bottom"
      title={description}
      rel={isInternalUrl ? undefined : 'noopener noreferrer'}
    >
      <div class="card-body">
        <div class="url-content flex items-center">
          <!-- 网站图标 -->
          <div class="url-img mr-2 flex items-center justify-center">
            {hasCustomIcon ? (
              <span
                class="site-icon inline-flex items-center justify-center"
                style={`color:${iconColor || 'var(--primary-color)'};background:${iconBg || 'rgba(64, 158, 255, 0.12)'}`}
                aria-hidden="true"
              >
                <Icon name={icon} />
              </span>
            ) : (
              <img 
                class="lazy site-favicon is-ready"
                src={defaultData.logo}
                data-src={faviconUrl}
                alt={title}
                loading="lazy"
                decoding="async"
                width="40"
                height="40"
              />
            )}
          </div>
          
          <!-- 网站信息 -->
          <div class="url-info flex-fill flex-1">
            <div class="text-sm overflowClip_1">
              <strong>{title}</strong>
            </div>
            <p class="overflowClip_1 m-0 text-muted text-xs">{description}</p>
          </div>
        </div>
      </div>
    </a>

    <!-- 直达链接 -->
    {showDirectLink && (
      <a 
        href={url} 
        class="togo text-center text-muted is-views" 
        data-id={id}
        data-toggle="tooltip" 
        data-placement="right" 
        title="直达" 
        rel={isInternalUrl ? undefined : 'nofollow noopener noreferrer'}
        target={isInternalUrl ? undefined : '_blank'}
      >
        <Icon name="ri:external-link-line" />
      </a>
    )}
  </div>
</div>

<style>
  .site-favicon {
    opacity: 0;
    transition: opacity 0.16s ease;
  }
  .site-favicon.is-ready {
    opacity: 1;
  }
  .site-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    font-size: 22px;
    line-height: 1;
  }
</style>
