---
import { searchGroups, defaultSearch } from '@/data/searchConfig';
import { Icon } from 'astro-icon/components';

const defaultGroupId = searchGroups.find((group) =>
  group.engines.some((engine) => engine.id === defaultSearch.id)
)?.id || searchGroups[0]?.id || '';
---

<div class="search-modal" id="search-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="search-modal-title" aria-hidden="true" transition:persist>
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-body">
        <h2 id="search-modal-title" class="sr-only">站内与网络搜索</h2>
        <div id="modal-search" class="s-search mx-auto my-4" data-search-root="modal">
          <div id="modal-search-list" class="hide-type-list">
            <div class="s-type">
              <button id="group-current" class="search-group-current" type="button" aria-expanded="false">常用</button>
              <div class="s-type-list" role="group" aria-label="搜索分类">
                {searchGroups.map((group) => (
                  <button
                    type="button"
                    class="search-group-tab"
                    data-search-group={group.id}
                    aria-pressed={group.id === defaultGroupId ? 'true' : 'false'}
                  >
                    {group.label}
                  </button>
                ))}
              </div>
            </div>

            <div class="search-groups-container">
              {searchGroups.map((group) => (
                <div class={`search-group ${group.id}`} data-search-panel={group.id} hidden={group.id !== defaultGroupId}>
                  <ul class="search-type" aria-label={`${group.label}搜索引擎`}>
                    {group.engines.map((engine) => (
                      <li>
                        <input
                          class="sr-only"
                          type="radio"
                          name="type2"
                          id={`m_${engine.id}`}
                          value={engine.url}
                          data-engine-id={engine.id}
                          data-placeholder={engine.placeholder}
                          checked={engine.id === defaultSearch.id}
                        />
                        <label for={`m_${engine.id}`}><span class="text-muted">{engine.label}</span></label>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>

          <form action={defaultSearch.url} method="get" target="_blank" class="super-search-fm">
            <label class="sr-only" for="m_search-text">搜索关键词</label>
            <input
              type="search"
              id="m_search-text"
              class="smart-tips search-key h-[50px] w-full rounded-[6px] border border-line bg-white px-3 text-[15px] text-ink outline-none"
              autocomplete="off"
              placeholder={defaultSearch.placeholder}
              aria-autocomplete="list"
              aria-controls="modal-search-suggestions"
              required
            />
            <button class="search-submit" type="submit" aria-label="搜索">
              <Icon name="ri:search-line" aria-hidden="true" />
            </button>
          </form>
          <div id="smart-card-modal" class="card search-smart-tips search-hot-text rounded-xl" hidden>
            <ul id="modal-search-suggestions" data-search-suggestions hidden></ul>
          </div>
        </div>
      </div>

      <div class="search-modal-close-wrap">
        <button type="button" class="search-modal-close" data-dismiss="modal" aria-label="关闭搜索弹窗">
          <Icon name="ri:close-circle-line" class="icon-2x" aria-hidden="true" />
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .search-modal-close{border:0;background:transparent;color:inherit;padding:0;cursor:pointer}
  .search-modal #modal-search{max-width:800px;position:relative}
  .search-modal .s-type{position:absolute;top:0;left:0;z-index:23;width:75px}
  .search-modal .search-group-current{display:block;height:31px;width:75px;line-height:31px;text-align:center;color:#515c6b;background:#fff;border:1px solid #e5e7eb;border-radius:5px;padding:0}
  .search-modal .s-type-list{display:none;position:absolute;top:31px;padding:9pt 0;width:90px;background:#fff;border-radius:5px;box-shadow:0 9px 20px rgba(0,0,0,.16)}
  .search-modal .s-type:hover .s-type-list,.search-modal .s-type.open .s-type-list,.search-modal .s-type:focus-within .s-type-list{display:block}
  .search-modal .search-group-tab{display:block;position:static;width:100%;height:auto;line-height:1.5;margin:0;padding:5px 8px;background:transparent!important;color:#515c6b;border:0;text-align:center}
  .search-modal .search-group-tab[aria-pressed="true"]{background:rgba(126,126,126,.1)!important}
  .search-modal .search-group{padding-left:75px}
  .search-modal #m_search-text{height:50px}
  /* 原 Bootstrap .modal/.modal-dialog/.modal-content/.modal-body 的基础定位与布局 */
  .search-modal{position:fixed;top:0;left:0;display:none;width:100%;height:100%;overflow:hidden;outline:0;z-index:1085}
  .search-modal.show{display:block}
  .search-modal .modal-dialog{position:relative;width:auto;max-width:860px;margin:1rem auto;padding:0 .5rem;pointer-events:none}
  .search-modal .modal-content{position:relative;display:flex;flex-direction:column;width:100%;pointer-events:auto;background-clip:padding-box;border:1px solid rgba(0,0,0,.2);border-radius:.5rem;outline:0;overflow:visible}
  .search-modal .modal-body{position:relative;flex:1 1 auto;padding:1rem}
  :global(.modal-backdrop){position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:1084;background:rgba(0,0,0,.25);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
  .search-modal-close-wrap{position:absolute;bottom:-40px;width:100%;text-align:center}
  .search-modal #modal-search form{position:relative}
  .search-modal .search-smart-tips{position:relative;top:auto;left:auto;width:100%;max-height:min(320px,40vh);margin-top:8px;overflow-y:auto}
  .search-modal #modal-search .search-submit{position:absolute;top:0;right:0;margin:0;height:50px;line-height:50px;background:#313437;border:0;color:#fff}
  .search-modal #modal-search .search-submit svg{color:#fff;width:18px;height:18px}
  .search-type{display:flex;flex-wrap:wrap;gap:8px;padding:0;margin:0;list-style:none}
  .search-type li{margin:0}
  :global(.modal-open) #sidebar,:global(.modal-open) .page-header,:global(.modal-open) .main-content > :not(.search-modal){filter:blur(6px);pointer-events:none;user-select:none;transition:filter .2s ease}
  :global(.modal-backdrop),:global(.modal-backdrop.fade.show){background:rgba(0,0,0,.25);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
  .search-modal{z-index:1085}
  :global(.io-grey-mode) .search-modal .modal-content{background:#fff;color:#282a2d;border-color:#e5e7eb}
  :global(.io-black-mode) .search-modal .modal-content{background:#2c2e2f;color:#c6c9cf;border-color:#404040}
  :global(.io-black-mode) .search-modal .search-group-current{background:#2c2e2f;color:#c6c9cf;border-color:#404040}
  :global(.io-black-mode) .search-modal .s-type-list{background:#363738;box-shadow:0 9px 20px rgba(0,0,0,.3)}
  :global(.io-black-mode) .search-modal .search-group-tab{color:#c6c9cf}
  :global(.io-black-mode) .search-modal #m_search-text{background:#2c2e2f;color:#fff;border:1px solid #404040}
  :global(.io-black-mode) .search-modal #modal-search .search-submit{background:#2c2e2f}
  :global(.io-black-mode) .search-modal .text-muted{color:#bbb!important}
  @media (max-width:768px){
    .search-modal .modal-dialog{max-width:100%;margin:.5rem}.search-modal .modal-body{padding:12px}.search-modal #modal-search{max-width:none}
    .search-modal .s-type{position:relative;width:100%;margin-bottom:10px}.search-modal .search-group-current{width:100%;text-align:left;padding:0 12px}
    .search-modal .s-type-list{position:static;display:flex;flex-wrap:wrap;gap:8px;width:100%;padding:8px 0;box-shadow:none}.search-modal .search-group-tab{width:auto}
    .search-modal .search-group{padding-left:0}.search-modal #m_search-text{height:44px;padding-right:46px}.search-modal #modal-search .search-submit{height:44px;line-height:44px;width:44px}
  }
</style>
