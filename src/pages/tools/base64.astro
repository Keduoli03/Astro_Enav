---
import ToolLayout from '../../layouts/ToolLayout.astro';
import ToolPageStyles from '../../components/tools/ToolPageStyles.astro';
import ToolTabs from '../../components/tools/ToolTabs.astro';
import ToolField from '../../components/tools/ToolField.astro';
import ToolToolbar from '../../components/tools/ToolToolbar.astro';
import ToolStatus from '../../components/tools/ToolStatus.astro';

/* Shared Tailwind class strings (consistent with the React tool islands) */
const BTN =
  'inline-flex min-h-[40px] cursor-pointer items-center justify-center gap-2 rounded-control! border px-4 text-[13px] font-semibold leading-none no-underline transition duration-150 disabled:pointer-events-none disabled:opacity-45';
const BTN_PRIMARY = `${BTN} border-ink bg-ink text-paper hover:bg-[#24242a]`;
const BTN_SECONDARY = `${BTN} border-line bg-surface text-ink hover:border-ink/40 hover:bg-surface-2`;
const BTN_SM = 'min-h-[34px] px-3 text-[12px]';
const TEXTAREA =
  'min-h-[180px] w-full resize-y rounded-control! border border-line bg-paper px-3.5 py-3 font-mono text-[13px] leading-[1.7] text-ink outline-none transition focus:border-ink focus:ring-2 focus:ring-ink/5';
const PANEL = 'rounded-[12px] border border-line bg-surface p-5 md:p-6';
---

<ToolLayout title="Base64 编解码" description="支持文本编解码、图片转 Base64、Base64 转图片预览与下载。">

  <ToolTabs
    tabs={[
      { id: 'text', label: '文本' },
      { id: 'image', label: '图片' },
    ]}
  />

  <!-- ============ 文本 tab ============ -->
  <section class="mt-5" data-panel="text">

    <ToolField label="输入内容" hint="任意 UTF-8 文本">
      <textarea id="base64-input" class={TEXTAREA} rows="7"
        placeholder="请输入要编码或解码的文本内容..."></textarea>
    </ToolField>

    <ToolToolbar>
      <button id="base64-encode" class={BTN_PRIMARY} type="button">文本 → Base64</button>
      <button id="base64-decode" class={BTN_SECONDARY} type="button">Base64 → 文本</button>
      <button id="base64-clear" class={BTN_SECONDARY} type="button">清空</button>
      <button id="base64-copy" class={BTN_SECONDARY} type="button">复制结果</button>
    </ToolToolbar>

    <div class="h-4"></div>

    <ToolField label="输出结果">
      <textarea id="base64-output" class={TEXTAREA} rows="7"
        placeholder="结果会显示在这里" readonly></textarea>
    </ToolField>

  </section>

  <!-- ============ 图片 tab ============ -->
  <section class="mt-5 hidden" data-panel="image">
    <!-- 图片 → Base64 -->
    <div class={PANEL}>
      <ToolField label="上传图片" hint="≤ 10 MB · JPG/PNG/GIF/WebP">
        <label slot="suffix" class={`${BTN_PRIMARY} ${BTN_SM} inline-flex!`}>
          <span>选择图片</span>
          <input id="image-file-input" type="file" accept="image/*" hidden>
        </label>
        <div id="image-file-meta" class="tool-field__desc" style="min-height:1rem;"></div>
      </ToolField>

      <div class="mt-5 grid grid-cols-1 gap-4 lg:grid-cols-2">
        <ToolField label="原图预览">
          <div class="tool-preview-box">
            <img id="source-image-preview" class="tool-preview-image hidden" alt="原图预览" />
            <div id="source-image-empty" class="tool-preview-empty">选择图片后在此显示原图</div>
          </div>
        </ToolField>
        <ToolField label="Data URL 结果">
          <textarea id="image-base64-output" class={TEXTAREA}
            rows="10" placeholder="选择图片后自动生成 data:image/..." readonly></textarea>
        </ToolField>
      </div>

      <ToolToolbar mt={0.5}>
        <button id="image-to-base64-copy" class={`${BTN_SECONDARY} ${BTN_SM}`} type="button">复制 Base64</button>
        <button id="image-to-base64-clear" class={`${BTN_SECONDARY} ${BTN_SM}`} type="button">清空</button>
      </ToolToolbar>
    </div>

    <!-- Base64 → 图片 -->
    <div class={`${PANEL} mt-5`}>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <ToolField label="Base64 输入" hint="支持纯 Base64 或 data URL">
          <textarea id="base64-image-input" class={TEXTAREA}
            rows="10" placeholder="data:image/png;base64,iVBORw0K..."></textarea>
        </ToolField>
        <ToolField label="图片预览">
          <div class="tool-preview-box">
            <img id="base64-image-preview" class="tool-preview-image hidden" alt="Base64 图片预览" />
            <div id="image-preview-empty" class="tool-preview-empty">输入 Base64 后在此预览</div>
          </div>
        </ToolField>
      </div>

      <ToolToolbar mt={0.5}>
        <button id="base64-to-image-preview-btn" class={`${BTN_PRIMARY} ${BTN_SM}`} type="button">生成预览</button>
        <a id="base64-image-download" class={`${BTN_SECONDARY} ${BTN_SM} tool-disabled`}
          download="base64-image.png" href="#" aria-disabled="true">下载图片</a>
        <button id="base64-image-clear" class={`${BTN_SECONDARY} ${BTN_SM}`} type="button">清空</button>
      </ToolToolbar>
    </div>
  </section>

  <ToolStatus id="base64-status" mt={1} />

  <script is:inline>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      var status = $('base64-status');
      var MAX_IMAGE_BYTES = 10 * 1024 * 1024;
      var MAX_BASE64_LENGTH = 16 * 1024 * 1024;

      var input = $('base64-input');
      var output = $('base64-output');
      var imageFileInput = $('image-file-input');
      var imageFileMeta = $('image-file-meta');
      var imageBase64Output = $('image-base64-output');
      var sourceImagePreview = $('source-image-preview');
      var sourceImageEmpty = $('source-image-empty');
      var base64ImageInput = $('base64-image-input');
      var previewImg = $('base64-image-preview');
      var previewEmpty = $('image-preview-empty');
      var downloadLink = $('base64-image-download');

      function setStatus(text, isError) {
        if (!status) return;
        status.textContent = text || '';
        status.classList.toggle('tool-status--error', !!isError);
      }
      function flashStatus(text) {
        setStatus(text, false);
        clearTimeout(flashStatus._t);
        flashStatus._t = setTimeout(function () { setStatus('', false); }, 2500);
      }

      function encodeUtf8(str) {
        var bytes = new TextEncoder().encode(str);
        var bin = '';
        bytes.forEach(function (b) { bin += String.fromCharCode(b); });
        return btoa(bin);
      }
      function decodeUtf8(str) {
        var bin = atob(str);
        var bytes = Uint8Array.from(bin, function (c) { return c.charCodeAt(0); });
        return new TextDecoder().decode(bytes);
      }
      function normalizeImageDataUrl(v) {
        var raw = String(v || '').trim();
        if (!raw) return '';
        if (/^data:image\/[a-zA-Z0-9.+-]+;base64,/.test(raw)) return raw;
        return 'data:image/png;base64,' + raw.replace(/^base64,?/i, '').replace(/\s+/g, '');
      }
      function resetSourcePreview() {
        if (sourceImagePreview) { sourceImagePreview.removeAttribute('src'); sourceImagePreview.classList.add('hidden'); }
        if (sourceImageEmpty) sourceImageEmpty.style.display = 'flex';
        if (imageFileMeta) imageFileMeta.textContent = '';
      }
      function resetPreview() {
        if (previewImg) { previewImg.removeAttribute('src'); previewImg.classList.add('hidden'); }
        if (previewEmpty) previewEmpty.style.display = 'flex';
        if (downloadLink) {
          downloadLink.setAttribute('href', '#');
          downloadLink.setAttribute('aria-disabled', 'true');
          downloadLink.classList.add('tool-disabled');
        }
      }
      async function copyText(value, ok) {
        if (!value) { setStatus('当前没有可复制的内容', true); return; }
        try { await navigator.clipboard.writeText(value); flashStatus(ok); }
        catch (e) { setStatus('复制失败，请手动复制', true); }
      }

      sourceImagePreview && sourceImagePreview.addEventListener('error', function () {
        resetSourcePreview(); setStatus('图片预览加载失败', true);
      });
      previewImg && previewImg.addEventListener('error', function () {
        resetPreview(); setStatus('图片解析失败，请确认 Base64 是否正确', true);
      });
      downloadLink && downloadLink.addEventListener('click', function (e) {
        if (downloadLink.classList.contains('tool-disabled')) e.preventDefault();
      });

      $('base64-encode').addEventListener('click', function () {
        try { output.value = encodeUtf8(input.value || ''); flashStatus('已编码为 Base64'); }
        catch (e) { setStatus('编码失败，请检查输入内容', true); }
      });
      $('base64-decode').addEventListener('click', function () {
        try { output.value = decodeUtf8(input.value || ''); flashStatus('已解码为文本'); }
        catch (e) { setStatus('解码失败，输入不是合法 Base64', true); }
      });
      $('base64-clear').addEventListener('click', function () {
        input.value = ''; output.value = ''; flashStatus('文本已清空');
      });
      $('base64-copy').addEventListener('click', function () {
        copyText(output.value || '', '结果已复制');
      });

      imageFileInput.addEventListener('change', function () {
        var file = imageFileInput.files && imageFileInput.files[0];
        if (!file) return;
        if (file.size > MAX_IMAGE_BYTES) {
          setStatus('图片不能超过 10 MB', true);
          imageFileInput.value = '';
          resetSourcePreview();
          return;
        }
        var reader = new FileReader();
        reader.onload = function () {
          var result = String(reader.result || '');
          imageBase64Output.value = result;
          sourceImagePreview.src = result;
          sourceImagePreview.classList.remove('hidden');
          sourceImageEmpty.style.display = 'none';
          var size = file.size >= 1024 * 1024
            ? (file.size / (1024 * 1024)).toFixed(2) + ' MB'
            : Math.max(1, Math.round(file.size / 1024)) + ' KB';
          imageFileMeta.textContent = file.name + ' · ' + size;
          flashStatus('图片已转换为 Base64');
        };
        reader.onerror = function () { setStatus('图片读取失败', true); };
        reader.readAsDataURL(file);
      });

      $('image-to-base64-copy').addEventListener('click', function () {
        copyText(imageBase64Output.value || '', '图片 Base64 已复制');
      });
      $('image-to-base64-clear').addEventListener('click', function () {
        imageBase64Output.value = '';
        imageFileInput.value = '';
        resetSourcePreview();
        flashStatus('图片结果已清空');
      });

      $('base64-to-image-preview-btn').addEventListener('click', function () {
        try {
          var raw = base64ImageInput.value || '';
          if (raw.length > MAX_BASE64_LENGTH) {
            resetPreview(); setStatus('Base64 过大 (>16 MB)', true); return;
          }
          var dataUrl = normalizeImageDataUrl(raw);
          if (!dataUrl) { resetPreview(); setStatus('请先输入 Base64', true); return; }
          previewImg.src = dataUrl;
          previewImg.classList.remove('hidden');
          previewEmpty.style.display = 'none';
          downloadLink.setAttribute('href', dataUrl);
          downloadLink.setAttribute('aria-disabled', 'false');
          downloadLink.classList.remove('tool-disabled');
          flashStatus('图片预览已生成');
        } catch (e) {
          resetPreview(); setStatus('图片解析失败', true);
        }
      });
      $('base64-image-clear').addEventListener('click', function () {
        base64ImageInput.value = '';
        resetPreview();
        flashStatus('图片预览已清空');
      });

      resetSourcePreview();
      resetPreview();
    })();
  </script>

  <ToolPageStyles />
</ToolLayout>
