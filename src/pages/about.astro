---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
import { SITE_DESCRIPTION, SITE_FAVICON, SITE_TITLE } from '../settings';
import ArtalkComment from '@/components/Utils/ArtalkComment.astro';
import {Icon} from 'astro-icon/components'

---

<Layout 
  title={`关于本站 - ${SITE_TITLE}`}
  description={`关于 ${SITE_TITLE}：${SITE_DESCRIPTION}`}
  favicon={SITE_FAVICON}
>
  <div class="mx-auto w-full max-w-5xl px-4">
    <!-- 页面标题 -->
    <div class="mb-10 text-center">
      <h1 class="mb-3 text-4xl font-bold">
        <Icon name="ri:information-line" class="mr-3 text-[#1677ff]" />
        关于本站
      </h1>
      <p class="text-muted text-lg">一个简洁、现代的网址导航站点</p>
    </div>

    <!-- 项目介绍卡片 -->
    <div class="card mb-4">
      <div class="card-body p-4">
        <div class="flex flex-wrap items-center">
          <div class="mb-3 w-full text-center md:mb-0 md:w-1/4">
            <div class="inline-flex size-20 items-center justify-center rounded-full bg-[#1677ff]">
              <Icon name="ri:rocket-2-line" class="text-3xl text-white" />
            </div>
          </div>
          <div class="md:w-3/4">
            <h3 class="card-title mb-3 text-xl font-semibold">项目简介</h3>
            <p class="card-text text-muted mb-0">
              这是一个基于 <strong>Astro</strong> 和 <strong>WebStack-Hugo</strong> 开发的现代化导航网站。
              采用响应式设计，支持暗色模式，为用户提供简洁、高效的网址收藏和导航体验。
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- 开发状态 -->
    <div class="alert alert-info mb-4 rounded-lg border border-[#b8daff] bg-[#d1ecf1] px-4 py-3 text-[#0c5460]">
      <div class="flex items-center">
        <Icon name="ri:information-line" class="mr-3 text-[#17a2b8]" />
        <div>
          <h6 class="mb-1 font-semibold">开发状态</h6>
          <p class="mb-0">项目仍在持续开发中，如遇到问题欢迎反馈！我们会及时处理并不断完善功能。</p>
        </div>
      </div>
    </div>

    <!-- 联系方式 -->
    <div class="card mb-4">
      <div class="card-body p-4">
        <h3 class="card-title mb-4 text-xl font-semibold">
          <Icon name="ri:mail-line" class="mr-2 text-[#1677ff]" />
          联系方式
        </h3>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
          <a href="https://github.com/Keduoli03/Astro_Enav" target="_blank" class="site-action site-action--dark flex items-center justify-center gap-3 rounded-[10px] border border-[#343a40] px-4 py-3 font-semibold text-[#343a40] transition duration-200">
            <Icon name="ri:github-line" class="shrink-0" />
            <span class="text-left">
              <span class="block font-bold">GitHub 仓库</span>
              <small class="text-muted">查看源码 & 提交 Issue</small>
            </span>
          </a>
          <a href="mailto:2801429414@qq.com" class="site-action site-action--primary flex items-center justify-center gap-3 rounded-[10px] border border-[#1677ff] px-4 py-3 font-semibold text-[#1677ff] transition duration-200">
            <Icon name="ri:mail-line" class="shrink-0" />
            <span class="text-left">
              <span class="block font-bold">邮箱联系</span>
              <small class="text-muted">2801429414@qq.com</small>
            </span>
          </a>
        </div>
      </div>
    </div>

    <!-- 快速导航 -->
    <div class="mb-10 text-center">
      <a href="./" class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-[10px] bg-[#1677ff] px-6 py-3 font-semibold text-white shadow transition duration-200 hover:-translate-y-px">
        <Icon name="ri:global-line" class="shrink-0" />
        返回首页
      </a>
    </div>

    <!-- 用户反馈区域 -->
    <div class="card mb-5">
      <div class="card-body p-4">
        <h3 class="card-title mb-3 text-xl font-semibold">
          <Icon name="ri:message-3-line" class="mr-2 text-[#27775d]" />
          用户反馈
        </h3>
        <p class="text-muted mb-4">
          如果你有任何建议、意见或发现了问题，欢迎在下方留言。你的反馈对我们非常重要！
        </p>
        <ArtalkComment />
      </div>
    </div>
  </div>

  <style>
    .card {
      border: none;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .card:hover {
      transform: translateY(-2px);
    }

    .site-action {
      transition: all 0.2s ease;
    }

    .site-action:hover {
      transform: translateY(-1px);
    }

    /* 暗色模式适配 - 修复样式问题 */
    :global(.io-black-mode) .card {
      background-color: #2c2e2f !important;
      border-color: #404040 !important;
      color: #c6c9cf !important;
    }

    :global(.io-black-mode) .card-title,
    :global(.io-black-mode) .card-text,
    :global(.io-black-mode) h1,
    :global(.io-black-mode) h3,
    :global(.io-black-mode) h6 {
      color: #c6c9cf !important;
    }

    :global(.io-black-mode) .text-muted {
      color: #a0a0a0 !important;
    }

    :global(.io-black-mode) .alert-info {
      background-color: rgba(23, 162, 184, 0.15) !important;
      border-color: rgba(23, 162, 184, 0.3) !important;
      color: #c6c9cf !important;
    }

    /* 暗色模式按钮适配 */
    :global(.io-black-mode) .site-action--dark {
      color: #ffffff !important;
      border-color: #6c757d !important;
      background-color: rgba(108, 117, 125, 0.2) !important;
    }

    :global(.io-black-mode) .site-action--dark:hover {
      background-color: #495057 !important;
      border-color: #495057 !important;
      color: #ffffff !important;
    }

    :global(.io-black-mode) .site-action--primary {
      color: #4dabf7 !important;
      border-color: #4dabf7 !important;
    }

    :global(.io-black-mode) .site-action--primary:hover {
      background-color: #4dabf7 !important;
      border-color: #4dabf7 !important;
      color: #ffffff !important;
    }

    :global(.io-black-mode) .site-action small.text-muted {
      color: #d1d3d4 !important;
    }

    /* 确保小文本在暗色模式下可读 */
    :global(.io-black-mode) small {
      color: #b8bcc0 !important;
    }
  </style>
</Layout>
