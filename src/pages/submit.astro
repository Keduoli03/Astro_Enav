---
// src/pages/submit.astro
import ArtalkComment from '@/components/Utils/ArtalkComment.astro';
import Layout from '../layouts/Layout.astro';
import { SITE_FAVICON, SITE_TITLE } from '../settings';
import { Icon } from 'astro-icon/components';
---

<Layout 
  title={`网站提交 - ${SITE_TITLE}`}
  description="分享你喜欢的网站，让更多人发现优质内容"
  favicon={SITE_FAVICON}
>
  <div class="mx-auto w-full max-w-5xl px-4">
    <!-- 页面标题 -->
    <div class="mb-10 text-center">
      <h1 class="mb-3 text-4xl font-bold">
        网站提交
      </h1>
      <p class="text-muted text-lg">分享你发现的优质网站，让更多人受益</p>
    </div>

    <!-- 提交指南 -->
    <div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-3">
      <div class="card mb-0! h-full">
        <div class="card-body p-6 text-center">
          <div class="mb-3">
            <Icon name="ri:sun-line" class="icon-2x text-amber-500" />
          </div>
          <h5 class="card-title mb-2 text-lg font-semibold">优质内容</h5>
          <p class="card-text text-muted">推荐实用、有价值的网站，避免重复或低质量内容</p>
        </div>
      </div>
      <div class="card mb-0! h-full">
        <div class="card-body p-6 text-center">
          <div class="mb-3">
            <Icon name="ri:file-info-line" class="icon-2x text-sky-500" />
          </div>
          <h5 class="card-title mb-2 text-lg font-semibold">详细信息</h5>
          <p class="card-text text-muted">请提供网站名称、链接、简介等完整信息</p>
        </div>
      </div>
      <div class="card mb-0! h-full">
        <div class="card-body p-6 text-center">
          <div class="mb-3">
            <Icon name="ri:time-line" class="icon-2x text-emerald-600" />
          </div>
          <h5 class="card-title mb-2 text-lg font-semibold">审核时间</h5>
          <p class="card-text text-muted">我们会在1-3个工作日内审核并添加优质网站</p>
        </div>
      </div>
    </div>

    <!-- 提交表单说明 -->
    <div class="card mb-4">
      <div class="card-body p-4">
        <h4 class="card-title mb-3 text-xl font-semibold">
          <Icon name="ri:send-plane-line" class="mr-2 text-[#1677ff]" />
          提交你的网站推荐
        </h4>
        <div class="alert alert-info rounded-lg border border-[#b8daff] bg-[#d1ecf1] px-4 py-3 text-[#0c5460]" role="alert">
          <Icon name="ri:file-info-line" class="mr-2" />
          <strong>提交格式建议：</strong>
          <ul class="mb-0 mt-2">
            <li><strong>网站名称：</strong>网站的中文或英文名称</li>
            <li><strong>网站链接：</strong>完整的网站URL地址</li>
            <li><strong>网站简介：</strong>简要描述网站的功能和特色</li>
            <li><strong>推荐理由：</strong>为什么推荐这个网站</li>
            <li><strong>分类建议：</strong>建议归类到哪个分类下</li>
          </ul>
        </div>
        <p class="text-muted mb-0">
          <Icon name="ri:heart-line" class="mr-1 text-red-500" />
          感谢你的分享！每一个推荐都让我们的导航站变得更加丰富和实用。
        </p>
      </div>
    </div>

    <!-- 评论区 -->
    <div class="card mb-5">
      <div class="px-4 pt-4 pb-1">
        <h5 class="mb-0 text-lg font-semibold">
          <Icon name="ri:message-3-line" class="mr-2 text-[#1677ff]" />
          在下方留言提交你的网站推荐
        </h5>
      </div>
      <div class="card-body">
        <ArtalkComment />
      </div>
    </div>
  </div>

  <style>
    .card {
      transition: transform 0.2s ease-in-out;
    }

    .card:hover {
      transform: translateY(-2px);
    }

    .io-black-mode .card {
      background-color: #2d3748;
      border-color: #4a5568;
    }

    .io-black-mode .text-muted {
      color: #a0aec0 !important;
    }

    .io-black-mode .alert-info {
      background-color: rgba(66, 153, 225, 0.1);
      border-color: #4299e1;
      color: #90cdf4;
    }

    .io-black-mode h1,
    .io-black-mode h4,
    .io-black-mode h5,
    .io-black-mode .card-title {
      color: #f7fafc;
    }
  </style>
</Layout>
