---
import Layout from './Layout.astro';
import ToolPageStyles from '../components/tools/ToolPageStyles.astro';
import { SITE_FAVICON, SITE_TITLE } from '../settings';
import '../styles/tools-tailwind.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '' } = Astro.props;
const pageTitle = `${title} - ${SITE_TITLE}`;
const pageDescription = description || `${title}，${SITE_TITLE}内置工具页面`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  favicon={SITE_FAVICON}
>
  <ToolPageStyles />
  <div class="tool-page px-4 pb-6 md:px-6 lg:px-8">
    <div class="mx-auto w-full max-w-5xl">
      <div class="tool-panel">
          <div class="tool-header">
            <div class="tool-headline">
              <h1 class="tool-title mb-0">{title}</h1>
              <div class="tool-kicker">Tools</div>
            </div>
            {description && <p class="tool-desc mt-1 mb-0">{description}</p>}
          </div>
          <div class="tool-content">
            <slot />
          </div>
        </div>
      </div>
    </div>

  <style>
    .tool-page {
      padding-bottom: 24px;
    }
    .tool-panel {
      background: var(--tool-surface);
      border: 1px solid var(--tool-border);
      border-radius: 16px;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04), 0 12px 32px rgba(15, 23, 42, 0.08);
      overflow: hidden;
    }
    .io-black-mode .tool-panel {
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 14px 40px rgba(0, 0, 0, 0.35);
    }
    .tool-header {
      padding: 1.5rem 1.75rem;
      border-bottom: 1px solid var(--tool-border);
      background:
        linear-gradient(var(--tool-surface-soft), var(--tool-surface-soft));
    }
    .tool-content {
      padding: 1.5rem;
    }
    @media (min-width: 768px) {
      .tool-header { padding: 1.75rem 2rem; }
      .tool-content {
        padding: 1.75rem 2rem;
      }
    }
    .tool-headline {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .tool-kicker {
      flex: 0 0 auto;
      padding: 4px 10px;
      border-radius: 999px;
      background: var(--tool-brand-soft);
      color: var(--tool-brand);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .tool-title {
      font-size: clamp(1.45rem, 3vw, 2.15rem);
      font-weight: 800;
      line-height: 1.15;
      color: var(--tool-text);
    }
    .tool-desc {
      max-width: 720px;
      color: var(--tool-text-soft);
      font-size: 0.98rem;
      line-height: 1.7;
    }
    @media (max-width: 768px) {
      .tool-headline {
        align-items: flex-start;
        gap: 12px;
      }
      .tool-kicker {
        margin-top: 4px;
      }
    }
  </style>
</Layout>
