---
import Sidebar from '../components/Sidebar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '@/components/Utils/SearchModal.astro';
import { ClientRouter, fade } from 'astro:transitions';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
  SITE_DESCRIPTION as DEFAULT_SITE_DESCRIPTION,
  SITE_FAVICON as DEFAULT_SITE_FAVICON,
  SITE_TITLE as DEFAULT_SITE_TITLE,
  SEARCH_BG,
  CONTENT_BG,
  SEARCH_BG_DARK,
  CONTENT_BG_DARK,
} from '../settings';
import { DARK_MODE, DEFAULT_THEME } from '../constants/constants';
import '../styles/global.css';
import '../styles/external.css';
import '../styles/tools-tailwind.css';

interface Props {
  title?: string;
  description?: string;
  favicon?: string;
  hideFooter?: boolean;
}

const isImageMeta = (value: unknown): value is ImageMetadata =>
  Boolean(value && typeof value === 'object' && 'src' in value && 'width' in value && 'height' in value);

const optimizeBackground = async (value: unknown, quality: number) => isImageMeta(value)
  ? getImage({ src: value, width: 1920, format: 'webp', quality })
  : null;

const contentLight = await optimizeBackground(CONTENT_BG, 80);
const contentDark = await optimizeBackground(
  isImageMeta(CONTENT_BG_DARK) ? CONTENT_BG_DARK : CONTENT_BG,
  80,
);
const searchLight = await optimizeBackground(SEARCH_BG, 90);
const searchDark = await optimizeBackground(
  isImageMeta(SEARCH_BG_DARK) ? SEARCH_BG_DARK : SEARCH_BG,
  90,
);

const hasSearch = Astro.slots.has('searchbar');
const {
  title = DEFAULT_SITE_TITLE,
  description = DEFAULT_SITE_DESCRIPTION,
  favicon = DEFAULT_SITE_FAVICON,
  hideFooter = false,
} = Astro.props;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f9f9f9" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <title>{title}</title>
  <link rel="icon" href={favicon} />
  {contentLight ? <link rel="preload" as="image" href={contentLight.src} fetchpriority="high" /> : null}
  {contentDark && contentDark.src !== contentLight?.src ? <link rel="preload" as="image" href={contentDark.src} fetchpriority="high" /> : null}
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="zh_CN" />
  <meta property="og:site_name" content={DEFAULT_SITE_TITLE} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <ClientRouter />

  <!-- Apply the persisted theme before the body is parsed to prevent a white
       first paint when the saved theme is dark. -->
  <script is:inline define:vars={{ DEFAULT_THEME, DARK_MODE }}>
    (() => {
      let theme = DEFAULT_THEME;
      try { theme = localStorage.getItem('theme') || DEFAULT_THEME; } catch {}
      const isDark = theme === DARK_MODE;
      document.documentElement.classList.toggle('theme-dark', isDark);
      document.documentElement.classList.toggle('theme-light', !isDark);
      document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
    })();
  </script>

  <style>
    html,body{background-color:#f9f9f9;color:#282a2d}
    html.theme-dark,html.theme-dark body{background-color:#1b1d1f!important;color:#c6c9cf!important}
    html.theme-light,html.theme-light body{background-color:#f9f9f9!important;color:#282a2d!important}
    body.io-black-mode{background-color:#1b1d1f!important;color:#c6c9cf!important}
    body.io-grey-mode{background-color:#f9f9f9!important;color:#282a2d!important}
    body{transition:none}
    body.page-loading,body.theme-init{transition:none!important}
    html.theme-switching body,html.theme-switching body *{transition:none!important}
    :root{--sidebar-blur:12px;--sidebar-border-color:rgba(0,0,0,.06);--sidebar-bg-color:linear-gradient(to bottom,rgba(255,255,255,.65),rgba(255,255,255,.45));--sidebar-header-shadow:0 6px 24px rgba(0,0,0,.12);--sidebar-popup-bg-color:linear-gradient(to bottom,rgba(245,245,245,.75),rgba(245,245,245,.64));--sidebar-text-color:#20272b;--sidebar-title-color:#1b2226;--sidebar-hover-bg:rgba(0,0,0,.06);--sidebar-active-bg:rgba(0,0,0,.06);--sidebar-submenu-bg:rgba(0,0,0,.05)}
    .global-bg-layer{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden;filter:blur(var(--content-bg-blur,0));transform:scale(1.01);background-color:#f9f9f9;background-image:var(--content-bg-light-image);background-size:cover;background-position:center;background-repeat:no-repeat}
    html.theme-dark .global-bg-layer{background-color:#1b1d1f;background-image:var(--content-bg-dark-image)}
    .global-bg-layer img,.search-bg-layer img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
    .page-container{position:relative;z-index:1;background:transparent!important}
    #search-bg{position:relative;overflow:visible}
    .search-bg-layer{position:absolute;inset:0;z-index:0;pointer-events:none;overflow:hidden;filter:blur(var(--search-bg-blur,0));background-image:var(--search-bg-light-image);background-size:cover;background-position:center;background-repeat:no-repeat}
    html.theme-dark .search-bg-layer{background-image:var(--search-bg-dark-image)}
    #search-bg>:not(.search-bg-layer){position:relative;z-index:1}
    .header-big.bg-gradual:before{display:none}
    ::view-transition-old(root),::view-transition-new(root){animation:none;mix-blend-mode:normal}
    /* transition:persist reparents the sidebar/header nodes on every route swap;
       their own CSS transitions (width/max-width/all) would otherwise animate
       from a transient mid-reparent layout instead of applying instantly. */
    html.astro-route-swap .sidebar-nav,
    html.astro-route-swap .sidebar-nav *,
    html.astro-route-swap .page-header,
    html.astro-route-swap .main-content{transition:none!important;animation:none!important}
  </style>
</head>
<body class="page-loading theme-init">
  <script is:inline define:vars={{ DEFAULT_THEME, DARK_MODE }}>
    (() => {
      let theme = DEFAULT_THEME;
      try { theme = localStorage.getItem('theme') || DEFAULT_THEME; } catch {}
      const isDark = theme === DARK_MODE;
      document.documentElement.classList.toggle('theme-dark', isDark);
      document.documentElement.classList.toggle('theme-light', !isDark);
      document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
      document.body.classList.toggle('io-black-mode', isDark);
      document.body.classList.toggle('io-grey-mode', !isDark);
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', isDark ? '#1b1d1f' : '#f9f9f9');
      requestAnimationFrame(() => document.body.classList.remove('theme-init'));
    })();
  </script>
  <script is:inline>
    document.addEventListener('astro:before-swap', () => document.documentElement.classList.add('astro-route-swap'));
    document.addEventListener('astro:after-swap', () => {
      requestAnimationFrame(() => document.documentElement.classList.remove('astro-route-swap'));
    });
  </script>

  <SearchModal />
  {contentLight || contentDark ? (
    <div id="global-bg" class="global-bg-layer" style={`--content-bg-light-image:url("${contentLight?.src || ''}");--content-bg-dark-image:url("${contentDark?.src || contentLight?.src || ''}")`} data-light-src={contentLight?.src || ''} data-dark-src={contentDark?.src || contentLight?.src || ''} transition:persist>
      <img id="global-bg-image" alt="" decoding="async" fetchpriority="high" />
    </div>
  ) : null}

  <div class="page-container">
    <Sidebar />
    <div class="main-content flex-fill flex-1">
      <Header />
      {hasSearch ? (
        <div class="header-big post-top css-color mb-4" id="search-bg">
          {searchLight || searchDark ? (
            <div class="search-bg-layer" style={`--search-bg-light-image:url("${searchLight?.src || ''}");--search-bg-dark-image:url("${searchDark?.src || searchLight?.src || ''}")`} data-light-src={searchLight?.src || ''} data-dark-src={searchDark?.src || searchLight?.src || ''}>
              <img id="search-bg-image" alt="" decoding="async" />
            </div>
          ) : null}
          <div class="s-search"><slot name="searchbar" /></div>
        </div>
      ) : null}
      <div id="content" class="content-site customize-site" transition:animate={fade({ duration: '200ms' })}><slot /></div>
      {hideFooter ? null : <Footer />}
    </div>
  </div>

  <script is:inline>
    (() => {
      try {
        if (localStorage.getItem('miniSidebar') === '1') document.getElementById('sidebar')?.classList.add('mini-sidebar');
      } catch {}
    })();
  </script>
  <script src="../scripts/search-suggest.ts"></script>
  <script src="../scripts/sidebar-controller.ts"></script>
  <script src="../scripts/background-controller.ts"></script>
  <script src="../scripts/ui-controls.ts"></script>
  <script src="../scripts/mobile-sidebar.ts"></script>
</body>
</html>
